[Unit]
Description=LapSKey — tray icon and settings
Documentation=file://%h/.local/share/lapskey/app/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/lapskey tray
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
